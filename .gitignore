.harness/
harness.generated/
~

# Orchestrator-workflow RUN state stays local (auditable per-machine history).
# .ai/workflow/ (kit templates + manifest) and .ai/solution-acceptance.json
# (the OW enforcement knob) are deliberately COMMITTED so the enforcement
# posture survives fresh clones and git worktrees — see
# docs/policy-packs/solution-acceptance.md ("Repo state and gitignore").
.ai/runs/

# Locally-installed agent tooling (orchestrator-workflow kit, not part of this repo)
.claude/
AGENTS.md
CLAUDE.md

# Dogfood smoke run artefacts — per-run transcripts, not committed
dogfood/*/transcript/

# Hermetic-spawn-allowlist test fixture directories (task 052f9d5b review
# G6): tests/runtime/hermetic-spawn-allowlist*.test.ts write short-lived
# fixture dirs directly under process.cwd() (the repo root), NOT
# os.tmpdir(), on purpose — do not "helpfully" move them to tmpdir.
# Required because (1) os.tmpdir() is the D3 EXEMPT path in
# tests/_helpers/hermetic-spawn-allowlist.ts itself, so a fixture binary
# placed there would be silently allowed through regardless of what's
# under test, and (2) the nested-vitest fixtures need real node_modules
# resolution for `vitest/config`, which an out-of-tree tmpdir copy can't
# reach (verified: fails with UNRESOLVED_IMPORT). Each test removes its
# own fixture dir in a try/finally or afterAll, but an aborted run
# (Ctrl-C, a crash) can leave one behind — ignored rather than deleted on
# the next run, so a partial run's evidence isn't silently destroyed.
hermetic-*/
