{
  "name": "@lannguyensi/harness",
  "version": "0.43.0",
  "description": "Declarative control plane for agent harnesses — one YAML for grounding, tools, memory, and hooks.",
  "license": "MIT",
  "homepage": "https://github.com/LanNguyenSi/harness",
  "repository": {
    "type": "git",
    "url": "https://github.com/LanNguyenSi/harness.git"
  },
  "bugs": {
    "url": "https://github.com/LanNguyenSi/harness/issues"
  },
  "keywords": [
    "claude-code",
    "agent",
    "harness",
    "policy",
    "evidence-ledger",
    "mcp"
  ],
  "type": "module",
  "bin": {
    "harness": "./dist/cli/main.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "scripts/runtime-reality-docker-probe.mjs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:integration": "HARNESS_INTEGRATION_TESTS=1 vitest run tests/integration/",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "check:ug-schema-drift": "node scripts/check-ug-schema-drift.mjs",
    "check:boundaries": "depcruise --config .dependency-cruiser.cjs src",
    "check:duplication": "node scripts/check-duplication.mjs",
    "check:no-only": "node scripts/check-no-only.mjs",
    "measure:bash-prefix-parse": "node scripts/measure-bash-prefix-parse.mjs",
    "measure:command-normalize": "node scripts/measure-command-normalize.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.3",
    "@lannguyensi/runtime-reality-checker": "^0.2.0",
    "@lannguyensi/understanding-gate": "^0.4.9",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "diff": "^9.0.0",
    "execa": "^9.4.0",
    "proper-lockfile": "^4.1.2",
    "yaml": "^2.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@vitest/coverage-v8": "^4.1.4",
    "dependency-cruiser": "18.0.0",
    "jscpd": "5.0.11",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
